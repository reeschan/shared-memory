# shared-memory のインデックス作成と検索の流れ (埋め込みと OpenSearch のつながり)
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py docs/architecture/data-flow.d2
# 緑の線 = インデックス作成、オレンジの線 = 検索
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  idx: {
    style: {
      stroke: "#2f9e44"
      stroke-width: 2
      font-color: "#2f9e44"
    }
  }
  qry: {
    style: {
      stroke: "#e8590c"
      stroke-width: 2
      font-color: "#e8590c"
    }
  }
}

md: "Markdown (memories/)" {
  class: ext
  icon: https://cdn.simpleicons.org/markdown/__MONO__
}

agent: "エージェントのクエリ\n(MCP search)" {
  class: ext
  icon: https://cdn.simpleicons.org/modelcontextprotocol/__MONO__
}

index: "インデックス作成 (CLI index / MCP write)" {
  class: zone
  direction: right

  chunk: "チャンク分割\n見出し単位・400〜800 字\n先頭に title を付ける" {
    class: svc
  }
  diff: "差分判定\ncontent_hash が変わったチャンクだけ" {
    class: svc
  }
  cache: "埋め込みキャッシュ\n.cache/embeddings (hash + モデル名)" {
    class: svc
    shape: cylinder
  }
}

ollama: "Ollama\nQwen3-Embedding-0.6B\n1024 次元" {
  class: svc
  width: 320
  icon: https://cdn.simpleicons.org/ollama/__MONO__
}

os: "OpenSearch (エイリアス memories)" {
  class: zone
  icon: https://cdn.simpleicons.org/opensearch
  direction: right

  text: "title / content\nSudachi で形態素解析 → BM25" {
    class: svc
  }
  vec: "embedding\nknn_vector 1024 次元 (HNSW / cosine)" {
    class: svc
  }
  pipe: "Search Pipeline\nmin_max 正規化\nBM25 0.4 + kNN 0.6" {
    class: svc
  }
  text -> pipe: BM25 のスコア
  vec -> pipe: kNN のスコア
}

search: "検索の後処理 (MCP サーバー)" {
  class: zone
  direction: right

  rescore: "再スコア (上位 50 チャンク)\n× 時間減衰 × (1 + log(1 + アクセス回数))\n× 出所の係数" {
    class: svc
  }
  group: "memory_id でまとめる\n上位 8 件の id・title・抜粋" {
    class: svc
  }
  rescore -> group
}

md -> index.chunk: 本文 {class: idx}
index.chunk -> index.diff {class: idx}
index.diff -> index.cache: キャッシュを確認 {class: idx}
index.cache -> ollama: 無いチャンクだけ\n(インストラクションなし) {class: idx}
ollama -> os.vec: 文書ベクトル\n(投入) {class: idx}
index.diff -> os.text: 本文 (投入) {class: idx}

agent -> ollama: 検索用インストラクション\n+ クエリ {class: qry}
ollama -> os.vec: クエリベクトル\n(kNN 検索) {class: qry}
agent -> os.text: クエリの語\n(BM25 検索) {class: qry}
os.pipe -> search.rescore: ハイブリッドスコア {class: qry}
