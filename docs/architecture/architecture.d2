# shared-memory のアーキテクチャ図
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py docs/architecture/architecture.d2
# 上から: エージェント → アプリ → ローカルのデータ / モデル → 設定で選ぶ外部 API
# 実線 = 既定で使う流れ、破線 = 任意 (設定で有効にしたときだけ) か非同期
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
  opt: {
    style.stroke-dash: 4
  }
}

agents: エージェント {
  class: saas
  direction: right

  claude: Claude Code {
    class: ext
    icon: https://cdn.simpleicons.org/anthropic/__MONO__
  }
  codex: Codex {
    shape: hexagon
    width: 90
  }
  kimi: Kimi Code {
    class: ext
    icon: https://cdn.simpleicons.org/moonshotai/__MONO__
  }
}

pc: "ローカル PC (127.0.0.1 のみ)" {
  class: zone
  direction: down
  icon: https://icons.terrastruct.com/tech%2Flaptop.svg

  app: "アプリ (packages/core を共有)" {
    class: zone
    direction: right
    icon: https://cdn.simpleicons.org/typescript

    sched: "定期実行\nタスクスケジューラ / launchd / systemd" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F273-calendar.svg
    }
    cli: "CLI (pnpm sm)\nindex / reindex / import / decay / gc" {
      class: svc
      icon: https://cdn.simpleicons.org/nodedotjs
    }
    mcp: "MCP サーバー\nsearch / get / write" {
      class: svc
      icon: https://cdn.simpleicons.org/modelcontextprotocol/__MONO__
    }
    sched -> cli: "decay 毎日\ngc 毎週" {class: opt}
  }

  data: "データ" {
    class: zone
    direction: right

    md: "Markdown\n唯一の正 (memories_dir)" {
      class: svc
      icon: https://cdn.simpleicons.org/markdown/__MONO__
    }
    os: "OpenSearch + Sudachi (Docker)\nBM25 + kNN の派生インデックス\n_meta に埋め込みの指紋" {
      class: svc
      icon: https://cdn.simpleicons.org/opensearch
    }
    sqlite: "SQLite\nアクセス統計・tier" {
      class: svc
      icon: https://cdn.simpleicons.org/sqlite
    }
  }

  models: "ローカルのモデル" {
    class: zone
    direction: right

    ollama: "Ollama (埋め込みの既定)\nQwen3-Embedding-0.6B" {
      class: svc
      icon: https://cdn.simpleicons.org/ollama/__MONO__
    }
    tei: "TEI リランカー (任意)\nDocker の --profile rerank" {
      class: svc
      icon: https://cdn.simpleicons.org/huggingface
    }
  }

  app -> data: "読む・書く・投入・ハイブリッド検索"
  app -> models: "埋め込み・リランク"
}

apis: "外部 API (設定で明示したときだけ本文を送る)" {
  class: saas
  direction: right

  embed: "OpenAI 互換の埋め込み\nprovider: openai (LM Studio・Sarashina など)" {
    class: svc
    icon: https://icons.terrastruct.com/essentials%2F112-server.svg
  }
  rerank: "リランク API (任意)\nflavor: cohere / voyage / sarashina" {
    class: svc
    icon: https://icons.terrastruct.com/essentials%2F112-server.svg
  }
}

github: "GitHub\nバックアップ" {
  class: ext
  icon: https://cdn.simpleicons.org/github/__MONO__
}

agents -> pc.app.mcp: MCP (Streamable HTTP)
pc.app -> apis: "埋め込み・リランク" {class: opt}
pc.data.md -> github: "開発者が差分を見て\nコミット・push" {class: opt}
